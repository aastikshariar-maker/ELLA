# OpenAI Configuration
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/aicofounder
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
DEBUG_MODE=development

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Settings
APP_NAME=AI Co-Founder Platform
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TIME_LIMIT=3600

# Feature Flags
ENABLE_MARKET_ANALYSIS=true
ENABLE_FINANCIAL_MODELING=true
ENABLE_STRATEGIC_PLANNING=true
ENABLE_OPERATIONS_OPTIMIZATION=true

# Email Configuration (Optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# External APIs
SERPAPI_KEY=your-serpapi-key
CRUNCHBASE_API_KEY=your-crunchbase-key
